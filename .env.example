# Names only. Put real values in Coolify (application folder TravelKIF) or a gitignored .env.

# Spreadsheet id from docs.google.com/spreadsheets/d/<ID>/edit.
# That id is a long mixed-case token. The out-of-band candidate is 40 hexadecimal
# characters, which is not a Google Sheets spreadsheet id — do not paste it.
# Share the sheet with the client_email inside GOOGLE_SERVICE_ACCOUNT_JSON.
GOOGLE_SHEET_ID=

# Full service-account key JSON, one line. The Cloud Console page is not a key.
GOOGLE_SERVICE_ACCOUNT_JSON=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

PUBLIC_SITE_URL=https://privatetrip.travelkif.id

# Promo copy is "Akhir Tahun" and "periode November–Desember".
# The countdown ends at 23:59:59 on 31 December 2026, Western Indonesia Time
# (WIB, UTC+7), the audience clock. The 12 hari / 08:45:30 figures in Figma are a static mock.
PROMO_ENDS_AT=2026-12-31T23:59:59+07:00

# Leave empty until Google Ads is ready. The gtag snippet is omitted when this is empty.
PUBLIC_GTAG_ID=

# Optional E.164 digits for the floating WhatsApp button, country code included, no plus.
# Example shape: 6281234567890. When empty, the button uses mailto:voyage@travelkif.com.
PUBLIC_WHATSAPP_E164=
