# Names only. Put real values in Coolify (application folder TravelKIF) or a gitignored .env.

# Spreadsheet id from docs.google.com/spreadsheets/d/<ID>/edit.
# Leads are appended on the "Private Trip" tab. Share that sheet with the service account.
SHEET_ID=

# Full service-account key JSON, one line. The Cloud Console page is not a key.
GOOGLE_SHEETS_KEY=

# Must match client_email inside GOOGLE_SHEETS_KEY.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

PUBLIC_SITE_URL=https://privatetrip.travelkif.id

# Promo copy is "Akhir Tahun" and "periode November–Desember".
# The countdown ends at 23:59:59 on 31 December 2026, Western Indonesia Time
# (WIB, UTC+7). The 12 hari / 08:45:30 figures in Figma are a static mock.
PROMO_ENDS_AT=2026-12-31T23:59:59+07:00

# Umami. Both must be set or the script is omitted.
UMAMI_SRC=
UMAMI_WEBSITE_ID=

# Google Ads hook. Leave empty until an id exists. The tag is not rendered when this is empty.
PUBLIC_GTAG_ID=
