---
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
---

<Base title="Terima kasih | TravelKIF" promo="off">
  <header class="nav">
    <a class="brand" href="/">
      <img src="/images/logo.png" width="118" height="27" alt="TravelKIF" />
      <span class="brand-rule"></span>
      <small>Private Trip</small>
    </a>
  </header>
  <main class="thanks">
    <div class="ph-card">
      <div
        id="thanks-art"
        class="thanks-art"
        role="img"
        aria-label="Confetti dan Menara Eiffel dengan lampu natal"
      ></div>
    </div>
    <h1>Yeay, permintaan kamu sudah masuk! 🎉</h1>
    <p>Kami akan konfirmasi harga &amp; ketersediaan via WhatsApp segera !</p>
    <a class="back-home" href="/">← Kembali ke beranda</a>
  </main>
  <Footer />
</Base>
